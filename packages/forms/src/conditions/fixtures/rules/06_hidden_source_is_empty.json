{
  "name": "поле условия «если» скрыто — для правила оно пустое, правило не срабатывает",
  "visible_if": {
    "responsible": { "all": [{ "field": "kind", "op": "eq", "value": "project" }] }
  },
  "rules": [
    {
      "id": "r1",
      "name": "Наблюдатель у лидов Т",
      "when": { "all": [{ "field": "responsible", "op": "eq", "value": "T" }] },
      "then": { "all": [{ "field": "observer", "op": "eq", "value": "A" }] },
      "fill": true
    }
  ],
  "values": { "responsible": "T", "kind": "lead" },
  "filled": { "responsible": "T", "kind": "lead" },
  "violations": []
}
