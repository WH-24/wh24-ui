{
  "name": "@wowhaus-24/ui-react",
  "version": "0.1.1",
  "description": "React headless wrappers over @wowhaus-24/ui-tokens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WOWHAUS-24/wh24-ui.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/WOWHAUS-24/wh24-ui#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && node scripts/copy-css.mjs",
    "typecheck": "tsc -b tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "tsc -b tsconfig.json --clean && rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@wowhaus-24/ui-tokens": "^0.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.10.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "^5.4.5",
    "vitest": "^4.1.5"
  }
}
