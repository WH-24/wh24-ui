{
  "name": "wh-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Wowhaus design system — tokens, themes, React primitives",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "npm test --workspaces --if-present",
    "clean": "tsc -b --clean && rm -rf packages/*/dist packages/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "overrides": {
    "happy-dom": "^20.10.6",
    "vite": "^8.1.3",
    "esbuild": "^0.25.0",
    "@babel/core": "^7.29.7"
  },
  "engines": {
    "node": ">=18"
  }
}
