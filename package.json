{
  "name": "wh-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Wowhaus design system — tokens, themes, React primitives",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "npm test --workspaces --if-present",
    "clean": "tsc -b --clean && rm -rf packages/*/dist packages/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
